# Supabase — shared with ClockBays.
# Local + Vercel "Preview/Development"  -> ClockBays DEV project
# Vercel "Production"                   -> ClockBays PROD project (jhwzshdiuzncsywxnsky)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — used ONLY by scripts/seed-policy.ts (never shipped to the client).
# Do NOT add this to the browser/runtime; keep it out of NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backups (see clock_bays/docs/backup-restore-plan.md).
# BACKUP_PASSPHRASE encrypts the nightly archives and the pre-restore safety
# copies written to the private `backups` bucket. Keep it in the password
# manager — losing it makes every bucket archive unreadable. ≥ 12 chars.
# CRON_SECRET is set by Vercel when a cron is configured (vercel.json) and is
# what /api/cron/backup checks. Locally, any value lets you curl the route.
BACKUP_PASSPHRASE=
CRON_SECRET=
