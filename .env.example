# Supabase — shared with ClockBays.
# Local + Vercel "Preview/Development"  -> ClockBays DEV project
# Vercel "Production"                   -> ClockBays PROD project (jhwzshdiuzncsywxnsky)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — used ONLY by scripts/seed-policy.ts (never shipped to the client).
# Do NOT add this to the browser/runtime; keep it out of NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
